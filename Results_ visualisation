# Fold-level statistical comparison

metric_name = "Weighted F1-score"

pivot_table = fold_metrics.pivot_table(
    index=fold_metrics.groupby("Model").cumcount(),
    columns="Model",
    values=metric_name
)

complete_results = pivot_table.dropna()

friedman_result = friedmanchisquare(
    *[
        complete_results[column].to_numpy()
        for column in complete_results.columns
    ]
)

print(
    f"Friedman statistic: {friedman_result.statistic:.4f}"
)

print(
    f"Friedman p-value: {friedman_result.pvalue:.6g}"
)

reference_model = "EAGLE-Net"

comparisons = []

for model_name in complete_results.columns:
    if model_name == reference_model:
        continue

    statistic, p_value = wilcoxon(
        complete_results[reference_model],
        complete_results[model_name],
        zero_method="wilcox",
        alternative="two-sided"
    )

    comparisons.append(
        {
            "Comparison": (
                f"{reference_model} vs {model_name}"
            ),
            "Wilcoxon statistic": statistic,
            "Unadjusted p-value": p_value
        }
    )

comparison_table = pd.DataFrame(
    comparisons
).sort_values(
    "Unadjusted p-value"
).reset_index(
    drop=True
)

number_of_tests = len(
    comparison_table
)

ordered_p_values = comparison_table[
    "Unadjusted p-value"
].to_numpy()

holm_adjusted = np.maximum.accumulate(
    np.minimum(
        1.0,
        ordered_p_values
        * np.arange(
            number_of_tests,
            0,
            -1
        )
    )
)

comparison_table[
    "Holm-adjusted p-value"
] = holm_adjusted

display(
    comparison_table
)

comparison_table.to_csv(
    OUTPUT_DIR / "statistical_comparisons.csv",
    index=False
)
